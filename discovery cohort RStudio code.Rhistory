install.packages(c("vegan","ggplot2","dplyr","tidyverse","tibble","pheatmap","stringr"))
library(vegan)
library(ggplot2)
library(dplyr)
library(tidyverse)
library(tibble)
library(pheatmap)
library(stringr)
setwd("E:/brain_virome")
getwd()
metadata <- read.delim("metadata.tsv", row.names = 1)
base_dir <- "E:/brain_virome"
folders <- list.dirs(base_dir, full.names = TRUE, recursive = FALSE)
folders <- folders[grepl("_analysis$", folders)]
abundance_list <- list()
for (f in folders) {
sample_id <- basename(f) %>% str_remove("_analysis")
file_path <- file.path(f, paste0(sample_id, "_final_table.tsv"))
if (!file.exists(file_path)) next
df <- read.delim(file_path)
df2 <- df[, c(3, 2)]
colnames(df2) <- c("Taxon", sample_id)
abundance_list[[sample_id]] <- df2
}
abundance_merged <- Reduce(function(x, y) full_join(x, y, by = "Taxon"), abundance_list)
abundance_matrix <- abundance_merged %>%
column_to_rownames("Taxon") %>%
as.data.frame()
abundance_matrix[] <- lapply(abundance_matrix, function(x) as.numeric(as.character(x)))
abundance_matrix[is.na(abundance_matrix)] <- 0
common_samples <- intersect(colnames(abundance_matrix), rownames(metadata))
abundance_matrix <- abundance_matrix[, common_samples]
metadata <- metadata[common_samples, ]
alpha <- data.frame(
Sample = colnames(abundance_matrix),
Observed = apply(abundance_matrix, 2, function(x) sum(x > 0)),
Shannon = vegan::diversity(t(abundance_matrix), index = "shannon"),
brain_region = metadata[colnames(abundance_matrix), "brain_region"],
Age = metadata[colnames(abundance_matrix), "Age"]
)
write.csv(alpha, "E:/brain_virome/alpha_diversity.csv", row.names = FALSE)
p1 <- ggplot(alpha, aes(x = brain_region, y = Shannon)) +
geom_boxplot(fill = "skyblue") +
geom_jitter(width = 0.2) +
theme_classic() +
labs(title = "Shannon Diversity across Brain Regions",
x = "Brain Region",
y = "Shannon Diversity Index") +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
p2 <- ggplot(alpha, aes(x = brain_region, y = Observed)) +
geom_boxplot(fill = "lightgreen") +
geom_jitter(width = 0.2) +
theme_classic() +
labs(title = "Viral Richness across Brain Regions",
x = "Brain Region",
y = "No. of Viral Taxa Detected") +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
p3 <- ggplot(alpha, aes(x = Age, y = Shannon)) +
geom_point() +
geom_smooth(method = "lm") +
theme_classic() +
labs(title = "Age vs Virome Diversity",
x = "Age (Years)",
y = "Shannon Diversity Index") +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
dist_bc <- vegdist(t(abundance_matrix), method = "bray")
pcoa <- cmdscale(dist_bc, k = 2)
pcoa_df <- data.frame(
Sample = rownames(pcoa),
PC1 = pcoa[, 1],
PC2 = pcoa[, 2]
)
pcoa_df <- merge(pcoa_df, alpha, by = "Sample")
p4 <- ggplot(pcoa_df, aes(x = PC1, y = PC2, color = brain_region)) +
geom_point(size = 3) +
theme_classic() +
labs(title = "Beta Diversity (Bray-Curtis PCoA)",
x = "PCoA1 (Bray-Curtis Distance)",
y = "PCoA2 (Bray-Curtis Distance)") +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
print(kruskal.test(Shannon ~ brain_region, data = alpha))
print(cor.test(alpha$Age, alpha$Shannon))
print(adonis2(dist_bc ~ brain_region, data = alpha))
mat_scaled <- t(scale(t(abundance_matrix)))
mat_scaled[is.na(mat_scaled)] <- 0
annotation <- metadata[, c("Age", "brain_region")]
colnames(annotation) <- c("Age (years)", "Brain Region")
annotation <- annotation[colnames(mat_scaled), , drop = FALSE]
# =========================
# SAVE FIGURES (ONLY CHANGE = DPI 600)
# =========================
ggsave("E:/brain_virome/Shannon.tiff", p1, dpi = 600, width = 8, height = 6, compression = "lzw")
ggsave("E:/brain_virome/Richness.tiff", p2, dpi = 600, width = 8, height = 6, compression = "lzw")
ggsave("E:/brain_virome/Age_vs_Diversity.tiff", p3, dpi = 600, width = 8, height = 6, compression = "lzw")
ggsave("E:/brain_virome/PCoA.tiff", p4, dpi = 600, width = 8, height = 6, compression = "lzw")
tiff("E:/brain_virome/Heatmap.tiff", width = 12, height = 14, units = "in", res = 600, compression = "lzw")
pheatmap(
mat_scaled,
annotation_col = annotation,
show_rownames = TRUE,
fontsize_row = 6,
main = "Discovery Cohort Virome Heatmap"
)
dev.off()
savehistory(file = "E:/brain_virome/discovery cohort RStudio code.Rhistory")
