library(dplyr)
library(purrr)
library(tibble)
library(openxlsx)
library(VennDiagram)
library(grid)
library(pheatmap)
library(ggplot2)
# =========================
# METADATA (FIXED PATH)
# =========================
metadata <- read.csv(
"C:/Users/HP/Downloads/Metadata_Validation_Cohort.csv",
row.names = 1
)
# =========================
# VALIDATION COHORT FILES
# =========================
files <- c(
"E:/Validation Cohort/SRR21161802_final_table.tsv",
"E:/Validation Cohort/SRR21161882_final_table.tsv",
"E:/Validation Cohort/SRR21161932_final_table.tsv",
"E:/Validation Cohort/SRR21161942_final_table.tsv",
"E:/Validation Cohort/SRR21161944_final_table.tsv",
"E:/Validation Cohort/SRR21161948_final_table.tsv"
)
abundance_list <- list()
for (file in files) {
sample_id <- gsub("E:/Validation Cohort/|_final_table.tsv", "", file)
df <- read.delim(
file,
header = FALSE,
sep = "\t",
stringsAsFactors = FALSE,
fill = TRUE
)
df <- df[, 1:3]
colnames(df) <- c("Accession", "Count", "Taxon")
df$Taxon <- trimws(df$Taxon)
df$Taxon <- gsub("\\s+", " ", df$Taxon)
df$Count <- suppressWarnings(as.numeric(df$Count))
df$Count[is.na(df$Count)] <- 0
df2 <- df[, c("Taxon", "Count")]
colnames(df2) <- c("Taxon", sample_id)
df2 <- df2 %>%
group_by(Taxon) %>%
summarise(across(all_of(sample_id), sum), .groups = "drop")
abundance_list[[sample_id]] <- df2
}
validation_df <- reduce(abundance_list, full_join, by = "Taxon")
validation_df[is.na(validation_df)] <- 0
# =========================
# PRIMARY COHORT MATRIX
# =========================
primary_df <- read.xlsx("E:/brain_virome/viral_abundance_matrix.xlsx")
primary_df[[1]] <- trimws(primary_df[[1]])
primary_df[[1]] <- gsub("\\s+", " ", primary_df[[1]])
primary_matrix <- primary_df %>%
column_to_rownames(var = names(primary_df)[1]) %>%
as.data.frame()
primary_matrix[] <- lapply(primary_matrix, function(x)
as.numeric(as.character(x))
)
primary_matrix[is.na(primary_matrix)] <- 0
primary_matrix <- as.matrix(primary_matrix)
# =========================
# VALIDATION MATRIX
# =========================
validation_matrix <- validation_df %>%
column_to_rownames("Taxon") %>%
as.matrix()
validation_matrix <- matrix(
as.numeric(validation_matrix),
nrow = nrow(validation_matrix),
dimnames = list(
rownames(validation_matrix),
colnames(validation_matrix)
)
)
validation_matrix[is.na(validation_matrix)] <- 0
# =========================
# TAXA OVERLAP
# =========================
primary_taxa <- rownames(primary_matrix)
validation_taxa <- rownames(validation_matrix)
shared_taxa <- intersect(primary_taxa, validation_taxa)
print(length(shared_taxa))
# =========================
# VENN DIAGRAM
# =========================
grid.newpage()
tiff(
"venn_diagram.tiff",
width = 6,
height = 6,
units = "in",
res = 600,
compression = "lzw"
)
venn.plot <- draw.pairwise.venn(
area1 = length(primary_taxa),
area2 = length(validation_taxa),
cross.area = length(shared_taxa),
category = c("Discovery Cohort", "Validation Cohort"),
fill = c("#A8D5BA", "#A7C7E7"),
alpha = 0.6,
cex = 1.5,
cat.cex = 1.3,
cat.pos = c(-20, 20),
cat.dist = 0.05,
main = "Overlap between Discovery and Validation Cohorts\nShared viral taxa = 13"
)
grid.draw(venn.plot)
dev.off()
pdf("venn_diagram.pdf", width = 6, height = 6)
grid.newpage()
grid.draw(venn.plot)
dev.off()
# =========================
# PREVALENCE TABLE
# =========================
prevalence <- function(mat) {
rowSums(mat > 0) / ncol(mat)
}
shared_table <- data.frame(
Viral_Taxon = shared_taxa,
Discovery_Prevalence = prevalence(primary_matrix)[shared_taxa],
Validation_Prevalence = prevalence(validation_matrix)[shared_taxa]
)
write.xlsx(
shared_table,
"E:/Validation Cohort/shared_viral_taxa_prevalence_table.xlsx",
rowNames = FALSE
)
# =========================
# HEATMAP (ONLY MODIFIED SECTION)
# =========================
keep <- apply(validation_matrix, 1, var) != 0
validation_matrix2 <- validation_matrix[keep, ]
mat_scaled <- t(scale(t(validation_matrix2)))
mat_scaled[is.na(mat_scaled)] <- 0
# FIXED METADATA ALIGNMENT
annotation <- metadata[, c("age_of_death", "brain_region")]
colnames(annotation) <- c("Age (in years)", "Brain Region")
annotation <- annotation[colnames(mat_scaled), , drop = FALSE]
# =========================
# HEATMAP OUTPUT (600 DPI)
# =========================
tiff(
"E:/Validation Cohort/validation_heatmap_600dpi.tiff",
width = 14,
height = 10,
units = "in",
res = 600,
compression = "lzw"
)
pheatmap(
mat_scaled,
annotation_col = annotation,
show_rownames = TRUE,
fontsize_row = 9,
fontsize_col = 11,
cluster_rows = TRUE,
cluster_cols = TRUE,
main = "Validation Cohort Virome Heatmap"
)
dev.off()
savehistory(file = "E:/Validation Cohort/Validation Cohort RStudio.Rhistory")
